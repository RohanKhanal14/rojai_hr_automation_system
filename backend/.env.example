# Database Configuration
MONGO_URI=mongodb://username:password@localhost:27017/yukti

# Server Configuration
PORT=3001
ENVIRONMENT=development

# JWT Secrets (Use random strings for each)
JWT_SIGNUP_SECRET=your_jwt_signup_secret_key_here
JWT_ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_here
JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key_here
JWT_RESET_PASSWORD_SECRET=your_jwt_reset_password_secret_key_here
JWT_NEW_PASSWORD_SECRET=your_jwt_new_password_secret_key_here

# Encryption Configuration (32 hex characters for key, 32 hex characters for iv)
ENCRYPTION_KEY=00000000000000000000000000000000
ENCRYPTION_IV=00000000000000000000000000000000
ENCRYPTION_ALGORITHM=aes-256-cbc

# Bcrypt Configuration
BCRYPT_ROUND=10

# VAPI Configuration (Voice API)
VAPI_WEBHOOK_BASE_URL=https://your-webhook-url.com

# Email Configuration (Mailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yukti.com

# Cloudinary Configuration (Image Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Groq Configuration (AI)
GROQ_API_KEY=your-groq-api-key

# Redis Configuration (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
